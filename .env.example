# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Required for encrypted provider keys stored by the owner in PostgreSQL.
# Generate a fresh 32+ character secret for each deployment and keep it private.
CREDENTIAL_ENCRYPTION_KEY=

# Optional owner-selected AI connection (can also be saved from Owner Settings)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=https://your-openai-compatible-provider.example/v1
# AI_MODEL=

# Optional Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google

# Optional ffmpeg override; ffmpeg-static works without this in the normal install
# FFMPEG_PATH=
